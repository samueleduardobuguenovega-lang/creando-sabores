# Copia este archivo a .env y ajusta los valores.
# En Docker el host de la base es "db"; fuera de Docker usa "localhost".

DATABASE_URL=postgres://creando:creando@localhost:5432/creando_sabores
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
PORT=3000
NODE_ENV=development

# 0 permite sesión por HTTP; en producción detrás de HTTPS usa 1.
COOKIE_SEGURA=0

# Claves de los usuarios que crea `npm run seed`.
CLAVE_ADMIN=Admin-2026
CLAVE_DOCENTE=Docente-2026

# 1 siembra datos de ejemplo al arrancar el contenedor.
SEMBRAR=0

# Rutas alternativas de los binarios, si no están en el PATH.
# GS_BIN=/usr/bin/gs
# MAGICK_BIN=/usr/bin/magick
