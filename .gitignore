# Dependencias
node_modules/
npm-debug.log*

# Configuración local. Ojo: la plantilla que sí se versiona se llama
# `entorno.ejemplo` justamente porque `.env.*` quedaría ignorado.
.env
.env.*

# Archivos subidos por los usuarios: nunca al repositorio
app/uploads/
uploads/

# Respaldos (ojo: no usar *.sql — se llevaría app/src/schema.sql)
respaldo-*.sql
respaldo-*.tgz
respaldos/

# Índice local del analizador de código (codebase-memory): pesa y no le sirve a nadie más
.codebase-memory/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
