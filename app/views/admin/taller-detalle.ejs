<%- include('../partials/head') %>

<p class="migas"><a href="/admin/talleres">Talleres</a> / <%= taller.nombre %></p>

<div class="barra-titulo">
  <h1><%= taller.nombre %></h1>
  <div class="acciones">
    <a class="boton" href="/admin/talleres/<%= taller.id %>/editar">Editar</a>
    <% if (usuario.rol === 'admin') { %>
      <form method="post" action="/admin/talleres/<%= taller.id %>/eliminar" class="en-linea"
            onsubmit="return confirm('¿Eliminar el taller y todo lo asociado (recetas, documentos, ejecuciones)?');">
        <button type="submit" class="boton boton-peligro">Eliminar</button>
      </form>
    <% } %>
  </div>
</div>

<dl class="ficha">
  <dt>Estado</dt>
  <dd><span class="insignia insignia-<%= taller.estado %>"><%= etiquetaEstado[taller.estado] %></span></dd>
  <dt>Temática</dt>
  <dd><%= taller.tematica %></dd>
  <dt>Fecha planificada</dt>
  <dd><%= fecha(taller.fecha_planificada) %></dd>
  <dt>Responsable</dt>
  <dd><%= responsable %></dd>
  <dt>Descripción</dt>
  <dd><%= taller.descripcion || '—' %></dd>
</dl>

<div class="dos-columnas">
  <section>
    <h2>Recetas asociadas</h2>
    <% if (recetas.length === 0) { %>
      <p class="ayuda">Sin recetas todavía. Se asignan desde el módulo de recetas (T5).</p>
    <% } else { %>
      <ul class="lista-simple">
        <% recetas.forEach(function (receta) { %>
          <li><a href="/admin/recetas/<%= receta.id %>/editar"><strong><%= receta.codigo %></strong> · <%= receta.nombre %></a></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section>
    <h2>Ejecuciones</h2>
    <% if (ejecuciones.length === 0) { %>
      <p class="ayuda">Sin ejecuciones registradas (T6).</p>
    <% } else { %>
      <ul class="lista-simple">
        <% ejecuciones.forEach(function (ejecucion) { %>
          <li>
            <%= fecha(ejecucion.fecha_ejecucion) %> ·
            <%= ejecucion.cantidad_participantes %> participantes
            <% if (ejecucion.observaciones) { %><br><span class="ayuda"><%= ejecucion.observaciones %></span><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section>
    <h2>Documentos</h2>
    <% if (documentos.length === 0) { %>
      <p class="ayuda">Sin documentos (T7).</p>
    <% } else { %>
      <ul class="lista-simple">
        <% documentos.forEach(function (documento) { %>
          <li><a href="/admin/documentos/<%= documento.id %>/ver"><%= documento.nombre %></a></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section>
    <h2>Videos</h2>
    <% if (videos.length === 0) { %>
      <p class="ayuda">Sin videos (T8).</p>
    <% } else { %>
      <ul class="lista-simple">
        <% videos.forEach(function (video) { %>
          <li><a href="<%= video.enlace %>" target="_blank" rel="noopener"><%= video.nombre %></a></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
