<%# Una ficha del fichero público: hueco de foto, título con los datos en línea y sello de
    estado. Espera `taller` (con nombre, estado, fecha_planificada, participantes, recetas)
    y los locals `etiquetaEstado` y `fecha`. %>
<li class="ficha-archivo">
  <span class="foto-hueco" aria-hidden="true">sin foto</span>

  <div>
    <h3 class="ficha-titulo"><%= taller.nombre %></h3>
    <p class="ficha-meta">
      <span><%= fecha(taller.fecha_planificada) %></span>
      <span><%= taller.participantes ? taller.participantes + ' participantes' : 'sin ejecutar' %></span>
      <span><%= taller.recetas %> <%= taller.recetas === 1 ? 'receta' : 'recetas' %></span>
    </p>
  </div>

  <span class="sello-archivo sello-<%= taller.estado %>">
    <%= etiquetaEstado[taller.estado] || taller.estado %>
  </span>
</li>
