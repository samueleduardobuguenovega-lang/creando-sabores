<%# Una ficha del archivo público: hueco de foto, datos como campos y sello de estado.
    Espera: taller (con id, nombre, tematica, descripcion, estado, fecha_planificada,
    ejecuciones y recetas), y los locals etiquetaEstado y fecha. %>
<li class="ficha-archivo">
  <span class="foto-hueco" aria-hidden="true">sin foto</span>

  <div class="ficha-texto">
    <h3><%= taller.nombre %></h3>
    <% if (taller.descripcion) { %>
      <p class="ficha-desc"><%= taller.descripcion %></p>
    <% } %>
    <p class="ficha-campos">
      <span class="campo-archivo">Fecha<b><%= fecha(taller.fecha_planificada) %></b></span>
      <span class="campo-archivo">Participantes<b><%= taller.participantes || '—' %></b></span>
      <span class="campo-archivo">Ejecuciones<b><%= taller.ejecuciones %></b></span>
      <span class="campo-archivo">Recetas<b><%= taller.recetas %></b></span>
    </p>
  </div>

  <span class="sello-archivo sello-<%= taller.estado %>">
    <%= etiquetaEstado[taller.estado] || taller.estado %>
  </span>
</li>
