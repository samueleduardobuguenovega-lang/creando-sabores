<%- include('../partials/head') %>

<section class="portada-archivo">
  <div>
    <p class="rotulo">Registro de talleres · <%= anioActual %></p>
    <h1>Talleres que se quedan</h1>
    <p class="portada-texto">
      Cada taller queda en su carpeta, con la receta, la foto del día y el número de
      participantes. Se puede revisar años después.
    </p>
    <div class="acciones">
      <a class="boton boton-primario" href="/talleres">Abrir el fichero</a>
      <a class="boton" href="/ejecuciones">Ver ejecuciones</a>
    </div>
  </div>

  <div class="resumen-archivo" aria-label="Resumen del archivo">
    <span>Talleres registrados<b><%= resumen.talleres %></b></span>
    <span>Finalizados<b><%= resumen.finalizados %></b></span>
    <span>Recetas<b><%= totalRecetas %></b></span>
    <span>Ejecuciones<b><%= totalEjecuciones %></b></span>
  </div>
</section>

<% if (talleres.length === 0) { %>
  <p class="ayuda">Todavía no hay talleres registrados.</p>
<% } else { %>
  <%
    // Una carpeta por temática; en la portada se muestran las primeras cuatro.
    const porTematica = new Map();
    talleres.forEach(function (taller) {
      const clave = taller.tematica || 'Sin temática';
      if (!porTematica.has(clave)) porTematica.set(clave, []);
      porTematica.get(clave).push(taller);
    });
    const grupos = Array.from(porTematica.entries()).slice(0, 4);
  %>

  <div class="carpetas">
    <% grupos.forEach(function (grupo) { const tematica = grupo[0]; const lista = grupo[1]; %>
      <section class="carpeta">
        <div class="carpeta-tab">
          <h2><%= tematica %></h2>
          <span><%= lista.length %></span>
        </div>
        <div class="carpeta-cuerpo">
          <ul class="fichas-archivo">
            <% lista.forEach(function (taller) { %>
              <%- include('../partials/ficha-taller', { taller: taller }) %>
            <% }) %>
          </ul>
        </div>
      </section>
    <% }) %>
  </div>

  <% if (porTematica.size > grupos.length) { %>
    <p class="ayuda">
      Quedan <%= porTematica.size - grupos.length %> carpetas más en el fichero.
      <a href="/talleres">Ver todas</a>.
    </p>
  <% } %>
<% } %>

<%- include('../partials/footer') %>
