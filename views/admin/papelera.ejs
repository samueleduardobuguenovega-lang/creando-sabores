<%- include('../partials/head') %>

<p class="migas"><a href="/panel">Panel</a> / Papelera</p>
<h1>Papelera</h1>
<p class="ayuda">
  Lo que se elimina llega aquí y se puede recuperar. Borrar definitivamente es la única acción
  que no tiene vuelta atrás.
</p>

<% if (elementos.length === 0) { %>
  <div class="estado-vacio">
    <p><%- icono('ok') %>La papelera está vacía: nada se ha eliminado.</p>
    <a class="boton" href="/panel">Volver al panel</a>
  </div>
<% } else { %>
  <table class="tabla">
    <caption class="visualmente-oculto">Elementos eliminados</caption>
    <thead>
      <tr>
        <th scope="col">Qué</th>
        <th scope="col">Nombre</th>
        <th scope="col">Eliminado</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% elementos.forEach(function (elemento) { %>
        <tr>
          <td data-columna="Qué"><%= ENTIDADES_PAPELERA[elemento.tabla] ? ENTIDADES_PAPELERA[elemento.tabla].etiqueta : elemento.tabla %></td>
          <td data-columna="Nombre"><%= elemento.referencia %></td>
          <td data-columna="Eliminado"><%= fecha(elemento.eliminado_en) %></td>
          <td data-columna="Acciones">
            <form method="post" action="/admin/papelera/<%= elemento.tabla %>/<%= elemento.id %>/restaurar" class="en-linea">
              <button type="submit" class="boton">Restaurar</button>
            </form>
            <form method="post" action="/admin/papelera/<%= elemento.tabla %>/<%= elemento.id %>/purgar" class="en-linea" data-confirmar="¿Borrar definitivamente? No se puede deshacer.">
              <button type="submit" class="boton boton-peligro">Borrar definitivo</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
