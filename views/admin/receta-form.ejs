<%- include('../partials/head') %>

<h1><%= titulo %></h1>

<% if (errores.length > 0) { %>
  <div class="mensaje mensaje-error" role="alert">
    <p>Revisa estos puntos:</p>
    <ul>
      <% errores.forEach(function (linea) { %><li><%= linea %></li><% }) %>
    </ul>
  </div>
<% } %>

<form novalidate method="post"
      action="<%= modo === 'crear' ? '/admin/recetas' : '/admin/recetas/' + receta.id %>"
      class="formulario">

  <label for="codigo">Código</label>
  <input id="codigo" name="codigo" type="text" required maxlength="40" value="<%= receta.codigo %>">

  <label for="nombre">Nombre de la receta</label>
  <input id="nombre" name="nombre" type="text" required maxlength="140" value="<%= receta.nombre %>">

  <label for="descripcion">Descripción</label>
  <textarea id="descripcion" name="descripcion" rows="5" maxlength="2000"><%= receta.descripcion %></textarea>

  <label for="enlace_pdf">Enlace al PDF</label>
  <input id="enlace_pdf" name="enlace_pdf" type="url" maxlength="2048" value="<%= receta.enlace_pdf || '' %>" placeholder="https://...">

  <% if (modo === 'editar') { %>
    <section class="bloque">
      <div class="barra-titulo">
        <h2>Archivos de la receta</h2>
        <span class="contador-resultados"><%= documentos.length %> archivo<%= documentos.length === 1 ? '' : 's' %></span>
      </div>

      <% if (documentos.length === 0) { %>
        <div class="estado-vacio"><p>Esta receta todavía no tiene PDF ni fotos.</p></div>
      <% } else { %>
        <ul class="fichas-archivo">
          <% documentos.forEach(function (documento) { %>
            <% const esImagen = /^image\//.test(documento.tipo_mime || ''); %>
            <li class="archivo-fila">
              <% if (esImagen) { %>
                <img class="miniatura" src="/admin/documentos/<%= documento.id %>/ver" alt="Vista previa de <%= documento.nombre %>" loading="lazy">
              <% } else { %>
                <span class="previa-icono" aria-hidden="true">PDF</span>
              <% } %>
              <span class="archivo-fila-datos">
                <a href="/admin/documentos/<%= documento.id %>/ver" target="_blank" rel="noopener"><%= documento.nombre %></a>
                <span class="ayuda"><%= esImagen ? 'Imagen' : 'PDF' %> · <%= Math.max(1, Math.round((documento.tamano || 0) / 1024)) %> KB</span>
              </span>
              <% if (usuario.rol === 'admin') { %>
                <form method="post" action="/admin/documentos/<%= documento.id %>/eliminar" class="en-linea" data-confirmar="¿Enviar «<%= documento.nombre %>» a la papelera? Se puede recuperar.">
                  <input type="hidden" name="volver" value="/admin/recetas/<%= receta.id %>/editar">
                  <button type="submit" class="boton boton-texto"><%- icono('eliminar') %>Eliminar</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% } else { %>
    <p class="ayuda">Guarda la receta y después podrás adjuntar sus PDF y fotos.</p>
  <% } %>

  <fieldset>
    <legend>Talleres asociados</legend>
    <% if (talleres.length === 0) { %>
      <p class="ayuda">No hay talleres disponibles para asociar.</p>
    <% } else { %>
      <% talleres.forEach(function (taller) { %>
        <label class="casilla">
          <input type="checkbox" name="talleres" value="<%= taller.id %>"
            <%= talleresSeleccionados.includes(taller.id) ? 'checked' : '' %>>
          <%= taller.nombre %> · <%= taller.tematica %>
        </label>
      <% }) %>
    <% } %>
  </fieldset>

  <div class="acciones">
    <button type="submit" class="boton boton-primario">Guardar</button>
    <a class="boton boton-texto" href="/admin/recetas">Cancelar</a>
    <% if (modo === 'editar' && usuario.rol === 'admin') { %>
      <button form="eliminar-receta" type="submit" class="boton boton-peligro">Eliminar</button>
    <% } %>
  </div>
</form>

<% if (modo === 'editar') { %>
  <%# Subida en la misma pantalla: formulario aparte porque este envío es
      multipart y el de arriba es urlencoded. %>
  <form method="post" action="/admin/documentos" enctype="multipart/form-data" class="formulario formulario-compacto">
    <input type="hidden" name="destino" value="receta:<%= receta.id %>">
    <input type="hidden" name="volver" value="/admin/recetas/<%= receta.id %>/editar">
    <label for="archivos-receta">Adjuntar PDF o fotos a esta receta (máx. 10 MB por archivo)</label>
    <input id="archivos-receta" type="file" name="archivos" accept="application/pdf,image/jpeg,image/png,image/webp" multiple data-previa="previas-receta" data-sin-carga>
    <ul class="previas-archivos" id="previas-receta" aria-live="polite"></ul>
    <button type="submit" class="boton">Subir archivos</button>
  </form>
<% } %>

<% if (modo === 'editar' && usuario.rol === 'admin') { %>
  <form id="eliminar-receta" method="post" action="/admin/recetas/<%= receta.id %>/eliminar"
        class="en-linea" data-confirmar="¿Eliminar esta receta y sus asociaciones?"></form>
<% } %>

<%- include('../partials/footer') %>
