<%- include('partials/head') %>

<section class="tarjeta tarjeta-angosta">
  <h1><%= titulo %></h1>
  <p><%= mensaje %></p>
  <% if (typeof detalle !== 'undefined' && detalle) { %>
    <p class="ayuda"><%= detalle %></p>
  <% } %>
  <%# Un error no se queda en el aviso: ofrece reintentar lo mismo que falló,
      volver al inicio y una salida con contenido. %>
  <div class="acciones">
    <% if (typeof reintentar !== 'undefined' && reintentar) { %>
      <a class="boton boton-primario" href="<%= typeof rutaActual !== 'undefined' ? rutaActual : '/' %>">Reintentar</a>
    <% } %>
    <a class="boton boton-secundario" href="/">Ir al inicio</a>
    <a class="boton boton-secundario" href="/talleres">Ver talleres</a>
  </div>
</section>

<%- include('partials/footer') %>
