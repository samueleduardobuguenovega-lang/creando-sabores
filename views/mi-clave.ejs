<%- include('partials/head') %>

<p class="migas"><a href="/panel">Panel</a> / Mi clave</p>

<section class="tarjeta">
  <h1>Cambiar mi clave</h1>
  <p class="ayuda">
    Tu clave es personal: no la compartas. Al cambiarla, la anterior deja de servir de inmediato.
  </p>

  <% if (errores && errores.length > 0) { %>
    <ul class="mensaje mensaje-error" role="alert">
      <% errores.forEach(function (linea) { %><li><%= linea %></li><% }) %>
    </ul>
  <% } %>

  <form method="post" action="/mi-clave" class="formulario">
    <label for="actual">Clave actual</label>
    <input id="actual" name="actual" type="password" autocomplete="current-password" required>

    <label for="nueva">Clave nueva</label>
    <input id="nueva" name="nueva" type="password" autocomplete="new-password" minlength="8" required>
    <p class="ayuda">Al menos 8 caracteres.</p>

    <label for="repetir">Repetir la clave nueva</label>
    <input id="repetir" name="repetir" type="password" autocomplete="new-password" minlength="8" required>

    <button type="submit" class="boton boton-primario">Cambiar clave</button>
  </form>
</section>

<%- include('partials/footer') %>
