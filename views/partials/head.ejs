<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    // Vista previa del enlace: cuando alguien pega la dirección en WhatsApp o
    // Telegram, estas líneas son lo que se ve. Una página puede cambiarlas
    // (su foto, su nombre); si no, van las del sitio.
    const descripcionPagina = locals.ogDescripcion
      || 'Talleres, recetas y clases de cocina del Colegio Urbano Yungay: el archivo completo del año.';
    const tituloCompartir = locals.ogTitulo || (titulo + ' · Creando Sabores');
    const imagenCompartir = locals.ogImagen
      ? (locals.ogImagen.startsWith('http') ? locals.ogImagen : urlBase + locals.ogImagen)
      : urlBase + '/img/compartir.jpg';
  %>
  <meta name="description" content="<%= descripcionPagina %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Creando Sabores">
  <meta property="og:locale" content="es_CL">
  <meta property="og:title" content="<%= tituloCompartir %>">
  <meta property="og:description" content="<%= descripcionPagina %>">
  <meta property="og:url" content="<%= urlActual %>">
  <meta property="og:image" content="<%= imagenCompartir %>">
  <meta property="og:image:alt" content="<%= locals.ogImagenAlt || 'Foto de una preparación de los talleres de Creando Sabores' %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= tituloCompartir %>">
  <meta name="twitter:description" content="<%= descripcionPagina %>">
  <meta name="twitter:image" content="<%= imagenCompartir %>">
  <title><%= titulo %> · Creando Sabores</title>
  <link rel="icon" href="/img/favicon-colegio.png" type="image/png" sizes="32x32">
  <link rel="stylesheet" href="/css/estilos.css?v=<%= versionAssets %>">
  <link rel="stylesheet" href="/css/cartel.css?v=<%= versionAssets %>">
  <script src="/js/app.js?v=<%= versionAssets %>" defer></script>
  <script src="/js/formularios.js?v=<%= versionAssets %>" defer></script>
</head>
<body>
  <a class="salto-contenido" href="#contenido">Saltar al contenido</a>

  <%# Aviso de carga: barra arriba y esqueleto de la página. Se activan desde
      /js/app.js solo cuando la navegación se demora más de 200 ms. %>
  <div id="barra-progreso" aria-hidden="true"></div>
  <div id="esqueleto-pagina" aria-hidden="true">
    <div class="esqueleto esqueleto-titulo"></div>
    <div class="esqueleto esqueleto-linea"></div>
    <div class="esqueleto esqueleto-linea"></div>
    <div class="esqueleto esqueleto-bloque"></div>
    <div class="esqueleto-fila">
      <div class="esqueleto"></div>
      <div class="esqueleto"></div>
      <div class="esqueleto"></div>
    </div>
  </div>

  <header class="cabecera">
    <div class="contenedor cabecera-fila">
      <%# La marca lleva al inicio en todas las vistas: por eso no hay un enlace
          "Inicio" aparte, ni en el menú ni en el pie. %>
      <a class="marca" href="/">
        <%# Las dos instituciones van juntas: el sello de Santo Tomás primero,
            el del colegio después, y recién entonces el nombre del proyecto. %>
        <span class="marca-logos">
          <img class="marca-logo" src="/img/santo-tomas.png" alt="Santo Tomás" width="40" height="40">
          <img class="marca-logo" src="/img/colegio-yungay.png" alt="Colegio Yungay" width="40" height="40">
        </span>
        <span class="marca-texto">Creando <strong>Sabores</strong></span>
      </a>

      <%# La navegación va siempre visible: cinco destinos caben en una fila y
          esconderlos detrás de un menú obliga a un toque de más en cada visita. %>
      <nav class="navegacion" aria-label="Menú principal">
          <% if (usuario) { %>
            <a href="/panel" class="<%= rutaActual === '/panel' ? 'activo' : '' %>" <%= rutaActual === '/panel' ? 'aria-current="page"' : '' %>><%- icono('panel') %>Panel</a>
            <a href="/admin/talleres" class="<%= rutaActual.startsWith('/admin/talleres') ? 'activo' : '' %>" <%= rutaActual.startsWith('/admin/talleres') ? 'aria-current="page"' : '' %>><%- icono('talleres') %>Talleres</a>
            <a href="/admin/recetas" class="<%= rutaActual.startsWith('/admin/recetas') ? 'activo' : '' %>" <%= rutaActual.startsWith('/admin/recetas') ? 'aria-current="page"' : '' %>><%- icono('recetas') %>Recetas</a>
            <a href="/admin/ejecuciones" class="<%= rutaActual.startsWith('/admin/ejecuciones') ? 'activo' : '' %>" <%= rutaActual.startsWith('/admin/ejecuciones') ? 'aria-current="page"' : '' %>><%- icono('ejecuciones') %>Ejecuciones</a>
            <%# El resto del archivo y la administración viven en un desplegable:
                cinco destinos se leen de un vistazo, nueve no. %>
            <details class="mas" data-plegable>
              <summary class="menu-boton">Más <span aria-hidden="true">▾</span></summary>
              <div class="mas-lista">
                <a href="/admin/documentos" class="<%= rutaActual.startsWith('/admin/documentos') ? 'activo' : '' %>"><%- icono('documentos') %>Documentos</a>
                <a href="/admin/videos" class="<%= rutaActual.startsWith('/admin/videos') ? 'activo' : '' %>"><%- icono('videos') %>Videos</a>
                <% if (usuario.rol === 'admin') { %>
                  <a href="/admin/usuarios" class="<%= rutaActual.startsWith('/admin/usuarios') ? 'activo' : '' %>"><%- icono('ojo') %>Usuarios</a>
                  <a href="/admin/auditoria" class="<%= rutaActual.startsWith('/admin/auditoria') ? 'activo' : '' %>"><%- icono('reloj') %>Auditoría</a>
                  <a href="/admin/papelera" class="<%= rutaActual.startsWith('/admin/papelera') ? 'activo' : '' %>"><%- icono('eliminar') %>Papelera</a>
                <% } %>
                <a href="/mi-clave" class="<%= rutaActual.startsWith('/mi-clave') ? 'activo' : '' %>"><%- icono('candado') %>Mi clave</a>
                <a href="/"><%- icono('panel') %>Sitio público</a>
              </div>
            </details>
          <% } else { %>
            <%# Barra pública: lo esencial para recorrer el archivo. Los índices
                de videos y documentos siguen existiendo por URL y como enlaces
                contextuales desde la portada y las fichas. %>
            <a href="/talleres" class="<%= rutaActual.startsWith('/talleres') ? 'activo' : '' %>" <%= rutaActual.startsWith('/talleres') ? 'aria-current="page"' : '' %>><%- icono('talleres') %>Talleres</a>
            <a href="/recetas" class="<%= rutaActual.startsWith('/recetas') ? 'activo' : '' %>" <%= rutaActual.startsWith('/recetas') ? 'aria-current="page"' : '' %>><%- icono('recetas') %>Recetas</a>
            <a href="/videos" class="<%= rutaActual.startsWith('/videos') ? 'activo' : '' %>" <%= rutaActual.startsWith('/videos') ? 'aria-current="page"' : '' %>><%- icono('videos') %>Videos</a>
            <a href="/documentos" class="<%= rutaActual.startsWith('/documentos') ? 'activo' : '' %>" <%= rutaActual.startsWith('/documentos') ? 'aria-current="page"' : '' %>><%- icono('documentos') %>Archivos</a>
            <a href="/ejecuciones" class="<%= rutaActual.startsWith('/ejecuciones') ? 'activo' : '' %>" <%= rutaActual.startsWith('/ejecuciones') ? 'aria-current="page"' : '' %>><%- icono('ejecuciones') %>Clases</a>
          <% } %>
      </nav>

      <%# Un solo buscador en todo el DOM: en escritorio va en la barra y en
          móvil ocupa la segunda fila de la cabecera. En /buscar la propia vista
          ya trae el formulario con el término cargado, así que no se duplica. %>
      <% if (!ocultarBusqueda) { %>
      <form class="busqueda" method="get" action="/buscar" role="search">
        <label class="visualmente-oculto" for="q">Buscar en el sitio</label>
        <input id="q" name="q" type="search" placeholder="Buscar talleres, recetas…" autocomplete="off" value="<%= terminoBusqueda || '' %>">
        <button type="submit" class="boton boton-icono" aria-label="Buscar"><%- icono('buscar') %></button>
      </form>
      <% } %>

      <div class="cuenta">
        <% if (usuario) { %>
          <span class="cuenta-nombre" title="<%= usuario.nombre %> · <%= usuario.rol === 'admin' ? 'Administrador' : 'Docente' %>"><%= usuario.nombre.length > 18 ? (usuario.rol === 'admin' ? 'Administrador' : 'Docente') : usuario.nombre %></span>
          <form method="post" action="/salir" class="en-linea">
            <button type="submit" class="boton boton-texto">Salir</button>
          </form>
        <% } else { %>
          <a class="boton boton-secundario" href="/login">Ingresar</a>
        <% } %>
      </div>
    </div>
  </header>

  <%# Cinta institucional: el mismo dato en todas las páginas públicas. %>
  <p class="cinta"><svg focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 3v7a2 2 0 0 0 4 0V3"/><path d="M8 10v11"/><path d="M16 3c-1.6 1.2-2.4 3-2.4 5.2 0 1.8.9 2.9 2.4 3.3V21"/><path d="M16 3h.8v8.5"/></svg>Recetario <%= anioActual %> · Colegio Yungay<span class="cinta-larga"> · talleres de cocina</span></p>

  <script>
    // En pantallas angostas el menú y el resumen del archivo arrancan plegados; en
    // escritorio quedan abiertos. Se vuelve a aplicar al girar o redimensionar.
    (function () {
      var plegables = document.querySelectorAll('details[data-plegable]');

      function plegar() {
        Array.prototype.forEach.call(plegables, function (detalle) {
          // Ningún desplegable arranca abierto: la navegación ya se ve siempre
          // y "Más" es una lista de secundarios, no un panel.
          detalle.open = false;
        });
      }
      plegar();
      // Chrome restaura el estado abierto/cerrado de <details> después de cargar:
      // se vuelve a aplicar al terminar, y también al girar el teléfono.
      window.addEventListener('load', plegar);
      window.addEventListener('orientationchange', plegar);

      function cerrarTodo(excepto) {
        var cerrado = null;
        Array.prototype.forEach.call(document.querySelectorAll('details[open]'), function (detalle) {
          if (detalle === excepto) return;
          // Un clic dentro de un desplegable cerrado no lo toca; cualquier otro
          // lo cierra, incluso con el marcado viejo donde el menú iba abierto.
          if (excepto && detalle.contains(excepto)) return;
          detalle.open = false;
          cerrado = cerrado || detalle;
        });
        return cerrado;
      }

      // Chrome cierra el <details> por su cuenta al presionar Escape y deja el
      // foco en <body>: el keydown llega cuando ya está cerrado. Se recuerda el
      // último disparador pulsado para devolverle el foco a mano.
      var ultimoDisparador = null;
      document.addEventListener('click', function (evento) {
        var disparador = evento.target.closest && evento.target.closest('summary');
        if (!disparador) return;
        var padre = disparador.parentElement;
        if (padre && padre.matches && padre.matches('.menu, .mas')) ultimoDisparador = disparador;
      });

      function devolverFoco() {
        if (!ultimoDisparador) return;
        ultimoDisparador.focus();
      }

      // Escape cierra cualquier desplegable abierto (menú móvil y "Más" de
      // escritorio) y devuelve el foco a su disparador. Se escucha en captura:
      // Chrome cierra el <details> por su cuenta antes de que llegue al burbujeo
      // y entonces ya no habría nada abierto que enfocar.
      document.addEventListener('keydown', function (evento) {
        if (evento.key !== 'Escape') return;
        var abiertos = Array.prototype.filter.call(
          document.querySelectorAll('details[open]'),
          function (detalle) { return detalle.matches('.menu, .mas'); }
        );
        if (!abiertos.length) { devolverFoco(); return; }
        var ultimo = abiertos[abiertos.length - 1];
        var resumen = ultimo.querySelector('summary');
        ultimo.open = false;
        if (resumen) {
          resumen.focus();
          requestAnimationFrame(function () { resumen.focus(); });
        }
        setTimeout(devolverFoco, 40);
        evento.preventDefault();
        evento.stopPropagation();
      }, true);

      // Chrome aplica su propio cierre después del keydown: se vuelve a intentar
      // cuando termina el turno del teclado.
      document.addEventListener('keyup', function (evento) {
        if (evento.key === 'Escape' && document.activeElement === document.body) devolverFoco();
      }, true);

      // Un clic fuera de un desplegable lo cierra, como cualquier menú.
      document.addEventListener('click', function (evento) {
        var detalle = evento.target.closest && evento.target.closest('details.menu, details.mas');
        cerrarTodo(detalle);
      });
    })();
  </script>

  <main id="contenido" class="contenedor">
    <% if (aviso) { %><p class="mensaje mensaje-ok" role="status"><%- icono('ok') %><%= aviso %></p><% } %>
    <% if (error) { %><p class="mensaje mensaje-error" role="alert"><%- icono('alerta') %><%= error %></p><% } %>
