<%- include('../partials/head') %>

<section class="caratula caratula-corta">
  <p class="rotulo">Material del taller</p>
  <h1>Documentos</h1>
  <p class="caratula-texto">
    Las pautas, las listas de materiales y las hojas de receta que se repartieron en cada taller: los PDF para imprimir y las fotos del paso a paso.
  </p>

  <form method="get" action="/documentos" class="filtros" aria-label="Filtros">
    <div class="filtro-busqueda">
      <label for="q-pagina">Buscar por nombre del archivo</label>
      <input id="q-pagina" name="q" type="search" value="<%= busqueda %>" placeholder="Ej.: lista de materiales">
    </div>
    <div>
      <label for="f-tipo">Tipo</label>
      <select id="f-tipo" name="tipo">
        <option value="">PDF y fotos</option>
        <option value="pdf" <%= tipo === 'pdf' ? 'selected' : '' %>>Solo PDF</option>
        <option value="imagen" <%= tipo === 'imagen' ? 'selected' : '' %>>Solo fotos</option>
      </select>
    </div>
    <div>
      <label for="f-origen">Viene de</label>
      <select id="f-origen" name="origen">
        <option value="">Todo el archivo</option>
        <option value="taller" <%= origen === 'taller' ? 'selected' : '' %>>Un taller</option>
        <option value="receta" <%= origen === 'receta' ? 'selected' : '' %>>Una receta</option>
      </select>
    </div>
    <button type="submit" class="boton">Filtrar</button>
  </form>
</section>

<p class="contador-resultados" role="status"><%= total %> archivo<%= total === 1 ? '' : 's' %></p>

<%- include('../partials/chips-filtros', { chips: chips, urlLimpiar: '/documentos' }) %>

<% if (documentos.length === 0) { %>
  <div class="estado-vacio">
    <p>No hay documentos con esos filtros.</p>
    <a class="boton" href="/documentos">Ver todos los documentos</a>
  </div>
<% } else { %>
  <ul class="galeria-archivos">
    <% documentos.forEach(function (documento) { %>
      <% const esImagen = /^image\//.test(documento.tipo_mime || ''); %>
      <li class="archivo">
        <a class="archivo-enlace" href="/documentos/<%= documento.id %>/ver">
          <span class="archivo-miniatura<%= esImagen ? '' : ' archivo-miniatura-pdf' %>">
            <% if (esImagen) { %>
              <%# La foto es el contenido: se muestra en vez de listar el nombre.
                  La tarjeta pide la miniatura de 480 px y sólo escala a la foto
                  completa cuando la pantalla la necesita de verdad. %>
              <img src="/documentos/<%= documento.id %>/miniatura"
                   srcset="/documentos/<%= documento.id %>/miniatura 480w,
                           /documentos/<%= documento.id %>/ver 1600w"
                   sizes="(min-width: 900px) 296px, 45vw"
                   alt="" loading="lazy" decoding="async">
            <% } else { %>
              <%- icono('pdf') %>
            <% } %>
          </span>
          <span class="archivo-pie">
            <strong class="archivo-nombre"><%= documento.nombre %></strong>
            <span class="ayuda">
              <%= esImagen ? 'Imagen' : 'PDF' %> ·
              <%= Math.max(1, Math.round(documento.tamano / 1024)) %> KB
            </span>
            <span class="ayuda archivo-origen"><%= documento.taller ? documento.taller : documento.codigo + ' · ' + documento.receta %></span>
          </span>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('../partials/footer') %>
