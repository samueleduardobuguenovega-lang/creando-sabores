<%- include('../partials/head') %>
<script src="/js/portada.js?v=<%= versionAssets %>" defer></script>
<%
  // Portada «cinta amarilla»: manda el taller que está en curso; si no hay
  // ninguno, la primera foto del archivo; si no hay fotos, el degradado del CSS.
  const enCurso = talleres.find(function (t) { return t.estado === 'en_ejecucion' && t.id_imagen; });
  const tallerConFoto = enCurso || talleres.find(function (t) { return t.id_imagen; });
  const destacados = talleres.slice(0, 3);
%>
<section class="cierre-foto">
  <% if (tallerConFoto) { %>
    <img class="cierre-imagen" src="/documentos/<%= tallerConFoto.id_imagen %>/ver" alt="" loading="eager">
  <% } %>
  <div class="cierre-texto">
    <% if (enElFuego && enElFuego.length) { %>
      <%# La etiqueta gira entre las recetas con foto; cada una es su propio
          enlace, así que sin JavaScript igual se puede entrar a la primera. %>
      <div class="plato-turno" data-turno>
        <span class="plato-prefijo">En el fuego</span>
        <ul class="plato-nombres">
          <% enElFuego.forEach(function (r, i) { %>
            <li>
              <a class="plato-nombre<%= i === 0 ? ' activo' : '' %>" href="/recetas/<%= r.id %>" title="<%= r.nombre %>"><%= r.nombre %></a>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } else if (tallerConFoto) { %>
      <p class="etiqueta-plato">
        <%= tallerConFoto.estado === 'en_ejecucion' ? 'En el fuego' : 'Del archivo' %>
        · <span class="nombre-plato"><%= tallerConFoto.nombre %></span>
      </p>
    <% } %>
    <h1 class="cierre-titulo">Creando Sabores<span>.</span></h1>
    <p class="cierre-bajada">
      <%= resumen.talleres === 1 ? 'Un taller de cocina' : resumen.talleres + ' talleres de cocina' %>: recetas, clases y lo que se sirvió este año
    </p>
  </div>
</section>

<div class="tarjeta-portada">
  <div class="tarjeta-acciones">
    <a class="boton boton-primario" href="/talleres"><%= resumen.talleres === 1 ? 'Ver el taller' : 'Ver los ' + resumen.talleres + ' talleres' %></a>
    <a class="boton boton-secundario" href="/recetas">Recetas</a>
    <a class="enlace-suave" href="/ejecuciones">Ver clases</a>
  </div>
  <% const cifras = [
       { n: resumen.talleres, uno: 'taller', varios: 'talleres' },
       { n: totalRecetas, uno: 'receta', varios: 'recetas' },
       { n: totalEjecuciones, uno: 'clase registrada', varios: 'clases registradas' },
       { n: resumen.tematicas, uno: 'temática', varios: 'temáticas' }
     ].filter(function (c) { return Number(c.n) > 0; }); %>
  <% if (cifras.length) { %>
  <ul class="cifras-portada" aria-label="Cifras del archivo">
    <% cifras.forEach(function (c) { %>
    <li><b><%= c.n %></b><span><%= Number(c.n) === 1 ? c.uno : c.varios %></span></li>
    <% }); %>
  </ul>
  <% } %>
</div>

<main id="contenido" class="contenedor contenido-principal">
  <% if (talleres.length === 0) { %>
    <div class="estado-vacio">
      <p>Todavía no hay talleres publicados en el archivo.</p>
      <% if (usuario) { %>
        <a class="boton boton-primario" href="/admin/talleres/nuevo"><%- icono('ok') %>Crear el primer taller</a>
      <% } else { %>
        <p class="ayuda">El archivo se irá llenando a medida que la coordinación publique los talleres de cada semestre.</p>
      <% } %>
    </div>
  <% } else { %>
    <div class="carpeta-tab">
      <h2>Lo último de la cocina</h2>
      <span><%= resumen.talleres %> en total</span>
    </div>
    <ul class="fichas-fila">
      <% destacados.forEach(function (taller) { %>
        <li class="fila-taller">
          <% if (taller.id_imagen) { %>
            <img class="fila-foto" src="/documentos/<%= taller.id_imagen %>/ver" alt="" loading="lazy">
          <% } else { %>
            <span class="fila-foto fila-folio" aria-hidden="true"><%= String(taller.id).padStart(2, '0') %></span>
          <% } %>
          <div class="fila-datos">
            <span class="fila-estado estado-<%= taller.estado %>"><%= etiquetaEstado[taller.estado] || taller.estado %></span>
            <h3><a href="/talleres/<%= taller.id %>"><%= taller.nombre %></a></h3>
            <p class="fila-meta">
              <%= taller.tematica %>
              <% if (taller.participantes) { %> · <%= taller.participantes %> participantes<% } %>
            </p>
          </div>
          <span class="fila-flecha" aria-hidden="true">→</span>
        </li>
      <% }) %>
    </ul>
    <p style="margin-top: var(--e4)">
      <a class="boton boton-secundario" href="/talleres">Ver todo el archivo</a>
    </p>
  <% } %>
</main>

<% if (talleres.length > 0) { %>
<section class="banda-negra pizarra">
  <div class="contenedor">
    <h2>El menú del año</h2>
    <%# Un solo recorrido: el total por temática se cuenta acá y no se repite abajo. %>
    <%
      const conteo = new Map();
      talleres.forEach(function (t) { conteo.set(t.tematica, (conteo.get(t.tematica) || 0) + 1); });
    %>
    <ul class="lista-tematicas">
      <% Array.from(conteo.entries()).forEach(function (par) { %>
        <li>
          <a href="/talleres?tematica=<%= encodeURIComponent(par[0]) %>">
            <span class="numero">×<%= par[1] %></span>
            <span class="nombre-tematica"><%= par[0] %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>

<%- include('../partials/footer') %>
