<%- include('../partials/head') %>

<section class="caratula">
  <p class="rotulo">Archivo de talleres · <%= anioActual %></p>
  <div class="caratula-grid">
    <div>
      <h1>Los talleres del colegio, con sus recetas y sus clases</h1>
      <p class="caratula-texto">
        Cada taller guarda sus recetas, sus documentos y sus videos. Abre una ficha
        para verla completa.
      </p>
      <div class="acciones">
        <a class="boton boton-primario" href="/talleres">Ver los <%= resumen.talleres %> talleres</a>
        <a class="enlace-suave" href="/recetas">Ver recetas</a>
        <a class="enlace-suave" href="/ejecuciones">Ver clases</a>
      </div>

      <%# Las cifras van como una sola tira de datos: antes competían con el
          título en una segunda columna y repetían el total de talleres. %>
      <ul class="resumen-chips" aria-label="Cifras del archivo">
        <li><b><%= resumen.finalizados %></b> finalizados</li>
        <li><b><%= resumen.en_ejecucion %></b> en ejecución</li>
        <li><b><%= totalRecetas %></b> recetas</li>
        <li><b><%= totalEjecuciones %></b> clases registradas</li>
        <li><b><%= resumen.tematicas %></b> temáticas</li>
      </ul>
    </div>
  </div>
</section>

<% if (talleres.length === 0) { %>
  <p class="ayuda">Todavía no hay talleres registrados.</p>
<% } else { %>
  <%
    // El archivo se agrupa por temática: una carpeta por temática, con sus fichas.
    const porTematica = new Map();
    talleres.forEach(function (taller) {
      const clave = taller.tematica || 'Sin temática';
      if (!porTematica.has(clave)) porTematica.set(clave, []);
      porTematica.get(clave).push(taller);
    });
    const grupos = Array.from(porTematica.entries());
  %>

  <div class="carpetas">
    <% grupos.forEach(function (grupo) { const tematica = grupo[0]; const lista = grupo[1]; %>
      <section class="carpeta">
        <div class="carpeta-tab">
          <h2><%= tematica %></h2>
          <span><%= porTematica.get(tematica).length %></span>
        </div>
        <div class="carpeta-cuerpo">
          <ul class="fichas-archivo">
            <% lista.forEach(function (taller) { %>
              <%- include('../partials/ficha-taller', { taller: taller }) %>
            <% }) %>
          </ul>
        </div>
      </section>
    <% }) %>
  </div>

<% } %>

<%- include('../partials/footer') %>
