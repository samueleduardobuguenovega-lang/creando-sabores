<%- include('../partials/head') %>

<%- include('../partials/migas', { migas: [
  { texto: 'Talleres', href: '/talleres' },
  { texto: taller.tematica, href: '/talleres?tematica=' + encodeURIComponent(taller.tematica) },
  { texto: taller.nombre }
] }) %>

<%
  const portada = documentos.find(function (documento) {
    return (documento.tipo_mime || '').startsWith('image/');
  });
%>

<section class="caratula caratula-con-foto">
  <p class="rotulo">
    <%= taller.tematica %> · <%= etiquetaEstado[taller.estado] || taller.estado %>
  </p>

  <div class="caratula-grid">
    <div class="caratula-principal">
      <h1><%= taller.nombre %></h1>
      <p class="caratula-texto"><%= taller.descripcion || 'Sin descripción.' %></p>
      <p class="ayuda">
        <%= /^Administraci/i.test(taller.responsable || '')
          ? 'A cargo del equipo docente.'
          : 'Taller a cargo de ' + taller.responsable + '.' %>
      </p>
      <div class="acciones">
        <a class="boton boton-primario" href="#recetas">Recetas (<%= recetas.length %>)</a>
        <a class="boton" href="#documentos">Archivos (<%= documentos.length %>)</a>
        <a class="boton" href="#videos">Videos (<%= videos.length %>)</a>
      </div>
    </div>

    <% if (portada) { %>
      <figure class="portada-entidad portada-caratula">
        <img src="/documentos/<%= portada.id %>/ver" alt="Foto de <%= taller.nombre %>" loading="eager">
      </figure>
    <% } %>

    <div class="maestra">
      <h2>Ficha del taller</h2>
      <dl>
        <div class="campo-maestra">
          <dt>Fecha</dt><span class="linea"></span><dd><%= fecha(taller.fecha_planificada) %></dd>
        </div>
        <div class="campo-maestra">
          <dt>Participantes</dt><span class="linea"></span><dd><%= participantes > 0 ? participantes : (taller.estado === 'planificado' ? 'por definir' : '0') %></dd>
        </div>
        <div class="campo-maestra">
          <dt>Recetas</dt><span class="linea"></span><dd><%= recetas.length %></dd>
        </div>
        <div class="campo-maestra">
          <dt>Archivos</dt><span class="linea"></span><dd><%= documentos.length %></dd>
        </div>
        <div class="campo-maestra">
          <dt>Videos</dt><span class="linea"></span><dd><%= videos.length %></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<section class="bloque-ficha bloque-recetas" id="recetas">
  <header class="titulo-bloque">
    <span class="titulo-bloque-icono" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 10h16v3a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6z"/>
        <path d="M2.5 10h19"/>
        <path d="M9 6.5c0-1 1-1.4 1-2.5M14 6.5c0-1 1-1.4 1-2.5"/>
      </svg>
    </span>
    <div>
      <h2>Recetas de este taller</h2>
      <p class="titulo-bloque-nota">
        <% if (recetas.length === 0) { %>Todavía no hay recetas cargadas.
        <% } else { %>Abre una receta para ver los ingredientes y los pasos.<% } %>
      </p>
    </div>
    <% if (recetas.length > 0) { %>
      <span class="cuenta-bloque"><%= recetas.length %></span>
    <% } %>
  </header>

  <% if (recetas.length === 0) { %>
    <p class="ayuda">Cuando se cargue una receta, aparece acá con su foto.</p>
  <% } else { %>
    <ul class="grilla-recetas">
      <% recetas.forEach(function (receta) { %>
        <li class="receta-mini">
          <a class="receta-mini-enlace" href="/recetas/<%= receta.id %>">
            <span class="receta-mini-medio">
              <%# Solo una foto subida llena este espacio. La ficha en PDF no se
                  usa aquí: una página blanca en una tarjeta blanca no se lee. %>
              <% if (receta.foto_id && receta.foto_es_imagen) { %>
                <img src="/documentos/<%= receta.foto_id %>/ver" alt="Foto de <%= receta.nombre %>" loading="lazy">
              <% } else { %>
                <span class="receta-mini-sin-foto" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 10h16v3a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6z"/>
                    <path d="M2.5 10h19"/>
                    <path d="M9 6.5c0-1 1-1.4 1-2.5M14 6.5c0-1 1-1.4 1-2.5"/>
                  </svg>
                  <span>Sin foto todavía</span>
                </span>
              <% } %>
            </span>
            <span class="receta-mini-cuerpo">
              <span class="receta-mini-codigo"><%= receta.codigo %></span>
              <strong><%= receta.nombre %></strong>
              <span class="receta-mini-abrir">Ver receta →</span>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="bloque-ficha" id="documentos">
  <h2>Archivos del taller</h2>
  <% if (documentos.length === 0) { %>
    <p class="ayuda">Este taller todavía no tiene archivos. Mientras tanto, puedes <a href="/documentos">ver el material de otros talleres</a>.</p>
  <% } else { %>
    <ul class="lista-archivos">
      <% documentos.forEach(function (documento) { %>
        <% const esImagen = (documento.tipo_mime || '').startsWith('image/'); %>
        <li class="archivo-item">
          <% if (esImagen) { %>
            <img class="archivo-miniatura" src="/documentos/<%= documento.id %>/ver" alt="" loading="lazy">
          <% } else { %>
            <span class="archivo-icono" aria-hidden="true">PDF</span>
          <% } %>
          <div class="archivo-datos">
            <strong><%= documento.nombre %></strong>
            <span class="ayuda"><%= esImagen ? 'Imagen' : 'PDF' %> · <%= Math.max(1, Math.round(documento.tamano / 1024)) %> KB</span>
          </div>
          <a class="boton" href="/documentos/<%= documento.id %>/ver">
            Ver <%= esImagen ? 'imagen' : 'PDF' %>
          </a>
          <a class="boton boton-secundario" href="/documentos/<%= documento.id %>/descargar" download>Descargar</a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="bloque-ficha" id="videos">
  <h2>Videos</h2>
  <% if (videos.length === 0) { %>
    <p class="ayuda">Este taller todavía no tiene videos. Mientras tanto, puedes <a href="/videos">ver los de otros talleres</a>.</p>
  <% } else { %>
    <ul class="lista-simple">
      <% videos.forEach(function (video) { %>
        <li class="elemento-simple elemento-video">
          <div>
            <strong><%= video.nombre %></strong>
            <p class="ayuda"><%= video.descripcion || 'Sin descripción.' %></p>
            <% if (video.embedUrl) { %>
              <iframe class="video-reproductor" src="<%= video.embedUrl %>" title="<%= video.nombre %>"
                      loading="lazy" allowfullscreen
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
            <% } else { %>
              <p class="ayuda">El enlace de este video no se puede mostrar aquí.</p>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="bloque-ficha" id="ejecuciones">
  <h2>Ejecuciones</h2>
  <% if (ejecuciones.length === 0) { %>
    <p class="ayuda">Este taller todavía no tiene ejecuciones registradas.</p>
  <% } else { %>
    <ul class="lista-donde">
      <% ejecuciones.forEach(function (ejecucion) { %>
        <li>
          <span class="donde-fila">
            <strong><%= fecha(ejecucion.fecha_ejecucion) %></strong>
            <span class="donde-meta"><%= ejecucion.cantidad_participantes %> participantes</span>
            <% if (ejecucion.video) { %><span class="insignia insignia-finalizado">Con video</span><% } %>
          </span>
          <% if (ejecucion.observaciones) { %>
            <p class="ayuda"><%= ejecucion.observaciones %></p>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<p><a class="boton" href="/talleres">Volver a talleres</a></p>

<%- include('../partials/footer') %>
