<%- include('../partials/head') %>

<section class="caratula caratula-corta">
  <p class="rotulo">Grabaciones del archivo</p>
  <h1>Videos</h1>
  <p class="caratula-texto">
    Lo que quedó grabado en cada taller: técnicas, preparaciones y cierres de sesión.
  </p>

  <form method="get" action="/videos" class="filtros" aria-label="Filtros">
    <div class="filtro-busqueda">
      <label for="q-pagina">Buscar por nombre</label>
      <input id="q-pagina" name="q" type="search" value="<%= busqueda %>" placeholder="Ej.: masa madre">
    </div>
    <div>
      <label for="f-taller">Taller</label>
      <select id="f-taller" name="taller">
        <option value="">Todos los talleres</option>
        <% talleres.forEach(function (taller) { %>
          <option value="<%= taller.id %>" <%= idTaller === taller.id ? 'selected' : '' %>><%= taller.nombre %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="boton">Filtrar</button>
  </form>
</section>

<p class="contador-resultados" role="status"><%= total %> video<%= total === 1 ? '' : 's' %></p>

<%- include('../partials/chips-filtros', { chips: chips, urlLimpiar: '/videos' }) %>

<% if (videos.length === 0) { %>
  <div class="estado-vacio">
    <p>No hay videos con esos filtros.</p>
    <a class="boton" href="/videos">Ver todos los videos</a>
  </div>
<% } else { %>
  <div class="carpetas">
    <% videos.forEach(function (video) { %>
      <section class="carpeta">
        <div class="carpeta-tab">
          <h2><a href="<%= video.destino %>"><%= video.nombre %></a></h2>
          <span><%= video.tematica || 'Video' %></span>
        </div>
        <div class="carpeta-cuerpo">
          <p class="ayuda">
            En <a href="<%= video.destino %>"><%= video.asociado %></a>
            <% if (video.proveedor) { %> · <%- icono('video') %>YouTube<% } %>
          </p>
          <% if (video.embedUrl) { %>
            <iframe class="video-reproductor" src="<%= video.embedUrl %>" title="<%= video.nombre %>"
                    loading="lazy" allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
          <% } else { %>
            <p class="ayuda">El enlace de este video no se puede mostrar aquí.</p>
          <% } %>
        </div>
      </section>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
